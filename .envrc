# direnv configuration for prolog-rlm
#
# Secrets live in .env (git-ignored), never in this file.
# Run `direnv allow` once after checkout.

if [ -f .env ]; then
  dotenv .env
else
  echo "prolog-rlm: no .env found; copy .env.example to .env and set OPENROUTER_API_KEY" >&2
fi

# Make `swipl -s bin/prolog-rlm.pl` resolvable from anywhere in the tree.
PATH_add bin
