#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
harness_root="$repo_root/agentProlog/deepseek-harness"
upstream="$harness_root/upstream"
profile="$harness_root/profile"
profile_name="agentProlog"
expected_harness_sha="141eb6fef83422698aef7a981029e843e8161534"

state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
dsh_home="${AGENTPROLOG_DSH_HOME:-$state_home/prolog-rlm/deepseek-harness}"
profile_mount="$dsh_home/profiles/$profile_name"
build_stamp="$dsh_home/upstream-build-sha"

fail() {
  printf 'agentProlog: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

need_command git
need_command node
need_command swipl

node -e '
  const [major, minor] = process.versions.node.split(".").map(Number)
  if (major < 22 || (major === 22 && minor < 19)) process.exit(1)
' || fail "Node >= 22.19.0 is required (found $(node --version))"

[[ -f "$upstream/apps/cli/lib/bin.js" ]] \
  || fail "DeepSeek Harness host artifacts are not built; run ./bin/build-agentProlog"

actual_harness_sha="$(git -C "$upstream" rev-parse HEAD 2>/dev/null)" \
  || fail "DeepSeek Harness submodule is not initialized; run ./bin/build-agentProlog"
[[ "$actual_harness_sha" == "$expected_harness_sha" ]] \
  || fail "DeepSeek Harness checkout is $actual_harness_sha; expected $expected_harness_sha; run ./bin/build-agentProlog"

[[ -f "$build_stamp" ]] \
  || fail "AgentProlog build stamp is missing; run ./bin/build-agentProlog"
[[ "$(cat "$build_stamp")" == "$expected_harness_sha" ]] \
  || fail "AgentProlog build is stale; run ./bin/build-agentProlog"

[[ -L "$profile_mount" ]] \
  || fail "AgentProlog profile is not mounted; run ./bin/build-agentProlog"
[[ "$(readlink -f "$profile_mount")" == "$(readlink -f "$profile")" ]] \
  || fail "AgentProlog profile mount points somewhere unexpected; run ./bin/build-agentProlog"

for dependency in \
  "$profile/node_modules/@deepseek-ai/dsh-agent" \
  "$profile/node_modules/@deepseek-ai/dsh-scope" \
  "$profile/node_modules/@deepseek-ai/dsh-session" \
  "$profile/node_modules/@prolog-rlm/dsh-agent-factory"
do
  [[ -e "$dependency" ]] || fail "runtime dependency missing: $dependency; run ./bin/build-agentProlog"
done

export DSH_HOME="$dsh_home"
exec node "$upstream/apps/cli/lib/bin.js" --profile "$profile_name" "$@"
