research_required(false).

% Slice scope: ADADR design slice for issue #336 (design record resolving
% OQ1-OQ6 of the approved RLM-RESEARCH-336). No runtime/implementation
% changes before operator design approval on PR #350.
requirement(research_approval, 'make research-approval passes with the approved RLM-RESEARCH-336 record present').
requirement(design_record_present, 'rage/336-text-streaming-design.org exists in the worktree').
requirement(oq_resolved, 'design record contains explicit resolutions for OQ1 through OQ6').
requirement(decision_gate_approved, 'design record records a GO decision gate with operator approval evidence, not worker self-approval').
requirement(slice_scope, 'no files outside rage/, research/ and .prolog/ changed in this slice').
requirement(static_load, 'static runtime check passes').
requirement(deterministic_suite, 'complete deterministic suite passes').
requirement(whitespace, 'git diff --check reports no whitespace errors').
