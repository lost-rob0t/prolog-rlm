% Ground facts and machine observations for this worktree.
:- discontiguous(brave_search/5).
:- discontiguous(observation/6).
task('ci-tree-sitter-runner').
repo_state('4e712eab5b8e867e45e076761be24d40a0e1fa78', 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855').
research_required(true).

requirement(diagnosis, 'PR-run tree-sitter failures were job code (apt packages absent from ubuntu-24.04), not runner infrastructure').
requirement(nix_lane, 'tree-sitter CI job builds the FFI and runs the full suite through the hermetic nix develop environment on ubuntu-latest').
requirement(container_fidelity, 'the exact job steps pass in a systemd-less ubuntu:24.04 container with a fresh nix install').
requirement(devshell_toolchain, 'nix devShell provides pkg-config so the FFI links libtree-sitter without undefined symbols').
requirement(grammar_fixtures, 'nix lane links all packaged grammars plus the incompatible-ABI fixture').
requirement(utf8_locale, 'devShell pins LANG/LC_ALL=C.UTF-8 so test sources are read as UTF-8').
requirement(readonly_test, 'read_only_project_root test registers the c grammar and blocks the KB root deterministically as a regular file').
requirement(baseline_suite, 'deterministic baseline checks pass').
requirement(workflow_lane, 'workflow uses the nix lane with container-safe daemon startup and no apt packages').
